# Conexión pooled (Transaction mode, puerto 6543) — la usa la app en runtime.
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"

# Conexión directa (Session mode, puerto 5432) — la usa Prisma Migrate.
# pgbouncer no soporta algunas operaciones que las migraciones necesitan.
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Supabase Auth — obtener en Settings > API del proyecto
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJ..."   # service_role (SECRETO — nunca exponer al cliente)

# Frontend URL (para el link de reset-password en emails de recuperación, y
# el redirect final del flujo de Google OAuth)
FRONTEND_URL="http://localhost:3001"

# Groq API (Orbi) — usada para generar descripción, categoría y etiquetas de producto con IA.
# Si queda vacía, el endpoint /products/ai-assist responde 503 en vez de romper el resto del backend.
GROQ_API_KEY=

# Auth propio (JWT HS256)
JWT_SECRET="generar con: openssl rand -hex 32"
JWT_EXPIRES_IN=15m

# Google OAuth (RBT-287) — OAuth Client ID tipo "Web application", creado en
# Google Cloud Console > APIs & Services > Credentials. El Authorized redirect
# URI configurado ahí debe ser IDÉNTICO a GOOGLE_REDIRECT_URI.
GOOGLE_CLIENT_ID="000000000000-xxxxxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/v1/auth/google/callback"

# Servidor
PORT=3000

# ── MercadoPago — suscripción del negocio a Órbita ────────────────────────────
# OJO: esto es el cobro NEGOCIO → ÓRBITA (débito automático del plan), distinto
# de los pagos CLIENTE → NEGOCIO que maneja el módulo mercadopago/.
#
# El Access Token de cualquier aplicación de MP puede crear preapprovals
# (confirmado: una app tipo "Checkout API vía Orders" alcanza, no hace falta
# una app "Suscripciones" separada).
MP_ACCESS_TOKEN=

# Plan cobrado. Producción: 5000 ARS cada 3 meses.
# Para probar el cobro recurrente sin esperar meses: FREQUENCY=3,
# FREQUENCY_TYPE=days. OJO: MP rechaza preapprovals por debajo de $15 ARS
# (piso de la plataforma, no configurable) — AMOUNT=1 falla, usar AMOUNT=15.
MP_SUBSCRIPTION_AMOUNT=5000
# Monto minimo que acepta Mercado Pago por cobro. Si el precio con descuento
# queda por debajo, MP rechaza el alta con "Cannot pay an amount lower than
# $ X" — se valida antes, al aplicar el codigo. Ojo: si el precio del plan es
# igual al minimo, NINGUN descuento puede funcionar.
MP_MIN_TRANSACTION_AMOUNT=15
MP_SUBSCRIPTION_FREQUENCY=3
MP_SUBSCRIPTION_FREQUENCY_TYPE=months   # "days" | "months"
MP_SUBSCRIPTION_CURRENCY=ARS

# Secret de firma del webhook (panel MP → Tus integraciones → Webhooks →
# "Clave secreta"). Si está vacío, el webhook NO valida firma (dev). En
# produccion es obligatorio para rechazar notificaciones falsas.
MP_WEBHOOK_SECRET=

# ── MercadoPago — OAuth Connect (checkout CLIENTE → NEGOCIO) ──────────────────
# Distinto del bloque de arriba (MP_*, suscripción NEGOCIO → ÓRBITA). Estos
# vienen de la misma app de MP ("Orbitasite" en el panel de developers) pero
# de su pestaña OAuth: cada comercio autoriza a Órbita a operar con SU PROPIA
# cuenta de MP — la plata de sus ventas entra directo a él, Órbita nunca la
# toca. Client ID no es secreto (viaja en la URL de autorización); Client
# Secret sí.
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=

# Debe ser IDÉNTICO al "Redirect URI" configurado en el panel de developers de
# MP (app "Orbitasite" > OAuth) o MP rechaza el intercambio del code.
MERCADOPAGO_REDIRECT_URI="http://localhost:3000/api/v1/mercadopago/oauth/callback"

# Passphrase para pgp_sym_encrypt/pgp_sym_decrypt (pgcrypto, nativo de
# Supabase) — cifra access_token/refresh_token de mp_credentials en reposo.
# Generar con: openssl rand -hex 32. Perder esta key = perder el acceso a
# todas las cuentas de MP ya conectadas (quedan sin poder descifrarse) — hace
# falta que cada comercio vuelva a conectar.
MERCADOPAGO_TOKEN_KEY=

# Altas pendientes de pago (wizard completo esperando que MP confirme el
# débito automático — ver PendingSignup en schema.prisma). Nada se crea en
# Business/Member hasta la confirmación, así que este cron es de bajo riesgo:
# solo borra filas de una tabla temporal sin relaciones. Horas de antigüedad
# antes de considerar una alta "abandonada".
PENDING_SIGNUP_TTL_HOURS=48

# Mail (Resend — https://resend.com/api-keys). Dejar RESEND_API_KEY vacío en
# desarrollo: sin ella el servicio loguea en consola en vez de mandar.
#
# Para probar sin verificar un dominio propio en Resend, se puede usar su
# sender de pruebas (MAIL_FROM=onboarding@resend.dev) — pero Resend SOLO
# entrega esos mails a la dirección con la que te registraste en tu cuenta de
# Resend, sin importar el `to` real que mande el código (ej: el email del
# cliente que pide resetear su contraseña). Es decir: mientras uses este
# sender, para ver el mail en la bandeja de entrada hay que probar contra esa
# misma dirección.
#
# En producción (Railway) usar MAIL_FROM="Órbita <no-reply@orbita-corp.com>".
# Requiere verificar orbita-corp.com como dominio en el dashboard de Resend
# (Domains → Add Domain → agregar los registros DNS que pide) ANTES de
# cambiar la variable — si se cambia sin verificar el dominio, Resend
# rechaza el envío en vez de entregarlo.
RESEND_API_KEY=
MAIL_FROM=onboarding@resend.dev

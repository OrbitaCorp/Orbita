{{!-- Estilo "Transaccional sobrio" v2 (equipo 19/08) — ver email-layout.hbs --}}
<h2 style="margin:0; font-size:20px; font-weight:700; color:#1a1f36; line-height:1.35; letter-spacing:-0.01em;">Tu devolución fue aprobada</h2>
<p style="margin:12px 0 0; color:#4f566b; font-size:13.5px; line-height:1.7;">Aprobamos la devolución de tu pedido #{{orderNumber}}. Este es el detalle del reembolso:</p>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-top:22px;">
  <tr>
    <td style="padding:10px 0; border-top:1px solid #e3e8ee; font-size:13.5px; color:#4f566b;">Método de reembolso</td>
    <td style="padding:10px 0; border-top:1px solid #e3e8ee; font-size:13.5px; color:#1a1f36; font-weight:600; text-align:right;">{{refundMethod}}</td>
  </tr>
  <tr>
    <td style="padding:12px 0 0; border-top:2px solid #1a1f36; font-size:14px; font-weight:700; color:#1a1f36;">Monto a reembolsar</td>
    <td style="padding:12px 0 0; border-top:2px solid #1a1f36; font-size:14px; font-weight:700; color:#1a1f36; text-align:right;">{{amount}} <span style="font-weight:400; color:#8792a2; font-size:12px;">ARS</span></td>
  </tr>
</table>
<p style="margin:20px 0 0; color:#8792a2; font-size:11.5px; line-height:1.65;">Cualquier consulta sobre los tiempos del reembolso, respondé este correo.</p>

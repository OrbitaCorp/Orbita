<div style="text-align:center;">
  <h2 style="margin:0; font-size:20px; font-weight:800; color:#0f172a;">Tu devolución fue aprobada</h2>
  <p style="margin:10px 0 0; color:#475569;">Aprobamos la devolución de tu pedido #{{orderNumber}}.</p>
</div>
<div style="margin-top:20px; background:{{colorPrimaryTint}}; border-radius:14px; padding:16px 20px;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
    <tr>
      <td style="padding:4px 0; font-size:13.5px; color:#475569;">Método de reembolso</td>
      <td style="padding:4px 0; font-size:13.5px; color:#0f172a; font-weight:600; text-align:right;">{{refundMethod}}</td>
    </tr>
    <tr>
      <td style="padding:8px 0 0; font-size:14.5px; font-weight:800; color:#0f172a; border-top:1px dashed rgba(15,23,42,0.12);">Monto a reembolsar</td>
      <td style="padding:8px 0 0; font-size:15px; font-weight:800; color:{{colorPrimary}}; text-align:right; border-top:1px dashed rgba(15,23,42,0.12);">{{amount}}</td>
    </tr>
  </table>
</div>

{{!-- Estilo "Transaccional sobrio" v2 (equipo 19/08) — ver email-layout.hbs.
      Configuración → Soporte: formulario genérico, negocio → Órbita. Reply-To
      ya apunta al email de quien escribió (ver MailService#sendSupportRequest) —
      esto es solo el contenido. Desde el 21/09 la consulta vive en la base con
      su número: el mail es el aviso, el hilo se sigue en el superadmin. --}}
<h2 style="margin:0; font-size:20px; font-weight:700; color:#1a1f36; line-height:1.35; letter-spacing:-0.01em;">Consulta #{{number}} — {{subject}}</h2>
<p style="margin:12px 0 0; color:#4f566b; font-size:13.5px; line-height:1.7;">{{#if isReply}}<strong style="color:#1a1f36;">{{businessName}}</strong> ({{businessSlug}}) volvió a escribir en una consulta que ya existía.{{else}}Nueva consulta desde el panel de <strong style="color:#1a1f36;">{{businessName}}</strong> ({{businessSlug}}).{{/if}}</p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-top:20px;">
  <tr>
    <td style="padding:8px 0; border-top:1px solid #e3e8ee; font-size:11px; color:#8792a2; text-transform:uppercase; letter-spacing:0.05em; width:110px;">Categoría</td>
    <td style="padding:8px 0; border-top:1px solid #e3e8ee; font-size:13.5px; color:#1a1f36;">{{category}}</td>
  </tr>
  <tr>
    <td style="padding:8px 0; border-top:1px solid #e3e8ee; font-size:11px; color:#8792a2; text-transform:uppercase; letter-spacing:0.05em;">Quién escribe</td>
    <td style="padding:8px 0; border-top:1px solid #e3e8ee; font-size:13.5px; color:#1a1f36;">{{memberName}} — <a href="mailto:{{memberEmail}}" style="color:#2563eb; text-decoration:none;">{{memberEmail}}</a></td>
  </tr>
  {{#if contactPhone}}
  <tr>
    <td style="padding:8px 0; border-top:1px solid #e3e8ee; font-size:11px; color:#8792a2; text-transform:uppercase; letter-spacing:0.05em;">Teléfono</td>
    <td style="padding:8px 0; border-top:1px solid #e3e8ee; font-size:13.5px; color:#1a1f36;">{{contactPhone}}</td>
  </tr>
  {{/if}}
</table>

<div style="margin-top:18px; padding:14px 16px; background:#f6f9fc; border-radius:8px; border:1px solid #e3e8ee;">
  <div style="font-size:11px; color:#8792a2; text-transform:uppercase; letter-spacing:0.05em; margin-bottom:6px;">Mensaje</div>
  <div style="font-size:13.5px; color:#1a1f36; line-height:1.7; white-space:pre-wrap;">{{message}}</div>
</div>

{{#if hasAttachments}}
<div style="margin-top:14px;">
  <div style="font-size:11px; color:#8792a2; text-transform:uppercase; letter-spacing:0.05em; margin-bottom:6px;">Adjuntos</div>
  {{#each attachments}}
  <div style="font-size:13px; line-height:1.7;"><a href="{{url}}" style="color:#2563eb; text-decoration:none;">{{name}}</a></div>
  {{/each}}
</div>
{{/if}}

{{#if adminUrl}}
{{> cta-button this url=adminUrl label="Responder desde el panel"}}
{{/if}}

<p style="margin:20px 0 0; color:#8792a2; font-size:11.5px; line-height:1.65;">La respuesta desde el panel le llega al negocio por mail y queda en su historial. Si respondés este mail directo (el Reply-To apunta a {{memberEmail}}), esa respuesta no queda registrada en la consulta.</p>

<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<!-- Geist Sans, la misma fuente de orbita.site (vía jsDelivr/Fontsource) — mejora
     progresiva: Apple Mail, iOS/Android Mail, Outlook.com y Yahoo la cargan; Gmail y
     Outlook de escritorio ignoran @font-face y caen solos al resto de la pila. -->
<style>
@font-face {
  font-family: 'Geist Sans';
  font-style: normal;
  font-weight: 400;
  font-display: swap;
  src: url(https://cdn.jsdelivr.net/fontsource/fonts/geist-sans@5.3.0/latin-400-normal.woff2) format('woff2');
}
@font-face {
  font-family: 'Geist Sans';
  font-style: normal;
  font-weight: 700;
  font-display: swap;
  src: url(https://cdn.jsdelivr.net/fontsource/fonts/geist-sans@5.3.0/latin-700-normal.woff2) format('woff2');
}
</style>
</head>
<!-- "Transaccional sobrio" v2 (elección del equipo 19/08, pulido a pedido de
     Ale): recibo de software serio con toques de empresa — barra de acento del
     color del negocio arriba de la tarjeta, aire generoso, footer con contexto
     ("por qué recibís este correo") y firma de Órbita. Todo a la izquierda. -->
<body style="margin:0; padding:0; background:#f4f6f9; font-family: 'Geist Sans', -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f6f9;">
    <tr>
      <td align="center" style="padding:48px 16px;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:540px;">
          <!-- Barra de acento: el ÚNICO gesto de color grande del mail — hace
               de firma visual del negocio sin romper la sobriedad. -->
          <tr><td style="height:4px; background:{{colorPrimary}}; border-radius:10px 10px 0 0; font-size:0; line-height:0;">&nbsp;</td></tr>
          <tr><td>
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#ffffff; border:1px solid #e3e8ee; border-top:none; border-radius:0 0 10px 10px; box-shadow:0 1px 3px rgba(26,31,54,0.06);">
              <tr>
                <td style="padding:34px 40px 0; text-align:left;">
                  {{#if logoUrl}}
                  <img src="{{logoUrl}}" alt="{{storeName}}" height="28" style="height:28px; width:auto; display:inline-block; border:0; vertical-align:middle;">
                  <span style="font-size:15px; font-weight:700; color:#1a1f36; letter-spacing:-0.01em; vertical-align:middle; padding-left:10px;">{{storeName}}</span>
                  {{else}}
                  <span style="font-size:15px; font-weight:700; color:#1a1f36; letter-spacing:-0.01em;">{{storeName}}</span>
                  {{/if}}
                </td>
              </tr>

              <tr>
                <td style="padding:26px 40px 10px; color:#1a1f36; font-size:13.5px; line-height:1.7; text-align:left;">
                  {{{contentHtml}}}
                </td>
              </tr>

              <tr><td style="padding:28px 40px 0;"><div style="border-top:1px solid #e3e8ee;"></div></td></tr>

              {{#unless isPlatform}}
              <tr>
                <td style="padding:16px 40px 6px;">
                  <table role="presentation" cellpadding="0" cellspacing="0" width="100%"><tr>
                    <td style="font-size:12px; font-weight:700; color:#1a1f36; text-align:left; vertical-align:middle;">{{storeName}}</td>
                    {{#if hasSocial}}
                    <td align="right" style="vertical-align:middle;">
                      <table role="presentation" cellpadding="0" cellspacing="0"><tr>
                        {{#if instagram}}<td style="padding:0 0 0 12px; color:#8792a2;"><a href="{{instagram}}" style="color:#8792a2; text-decoration:none;">{{> icon-instagram}}</a></td>{{/if}}
                        {{#if facebook}}<td style="padding:0 0 0 12px; color:#8792a2;"><a href="{{facebook}}" style="color:#8792a2; text-decoration:none;">{{> icon-facebook}}</a></td>{{/if}}
                        {{#if tiktok}}<td style="padding:0 0 0 12px; color:#8792a2;"><a href="{{tiktok}}" style="color:#8792a2; text-decoration:none;">{{> icon-tiktok}}</a></td>{{/if}}
                      </tr></table>
                    </td>
                    {{/if}}
                  </tr></table>
                </td>
              </tr>
              <tr>
                <td style="padding:0 40px 28px; text-align:left;">
                  <span style="font-size:10.5px; color:#8792a2; line-height:1.7;">Recibiste este correo porque tenés una cuenta o un pedido en {{storeName}}.{{#if contactEmail}} ¿Consultas? Escribinos a <a href="mailto:{{contactEmail}}" style="color:#8792a2; text-decoration:underline;">{{contactEmail}}</a>.{{/if}}</span>
                  <br><a href="https://www.orbita.site" style="font-size:10.5px; color:#b3bcc9; text-decoration:none;"><span style="vertical-align:middle;">{{> orbita-isotipo}}</span>&nbsp;Hecho por Órbita</a>
                </td>
              </tr>
              {{else}}
              <tr>
                <td style="padding:16px 40px 28px; text-align:left;">
                  <span style="font-size:10.5px; color:#8792a2; line-height:1.7;">Este es un correo de la plataforma Órbita para tu negocio.</span>
                  <br><a href="https://www.orbita.site" style="font-size:10.5px; color:#b3bcc9; text-decoration:none;"><span style="vertical-align:middle;">{{> orbita-isotipo}}</span>&nbsp;Hecho por Órbita</a>
                </td>
              </tr>
              {{/unless}}
            </table>
          </td></tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>

<div style="text-align:center;">
  <h2 style="margin:0; font-size:22px; font-weight:800; color:#0f172a; line-height:1.25;">Tu pedido #{{orderNumber}} está listo para retirar</h2>
  <p style="margin:14px auto 0; color:#475569; font-size:13px; line-height:1.6; max-width:320px;">¡Buenas noticias! Tu pedido en <strong style="color:#0f172a;">{{storeName}}</strong> ya está preparado y te espera.</p>
</div>
{{#if pickupAddress}}
<div style="margin-top:20px; background:{{colorPrimaryTint}}; border-radius:14px; padding:16px 20px; text-align:center;">
  <div style="font-size:12px; color:#64748b; margin-bottom:6px;">Retiralo en</div>
  <div style="font-size:14.5px; font-weight:700; color:#0f172a;">{{pickupAddress}}</div>
</div>
{{/if}}
<p style="text-align:center; color:#94a3b8; font-size:10.5px; margin:20px 0 0;">Acordate de mencionar el número de pedido cuando vengas a buscarlo.</p>

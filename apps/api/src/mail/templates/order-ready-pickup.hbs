{{!-- Estilo "Transaccional sobrio" v2 (equipo 19/08) — ver email-layout.hbs --}}
<h2 style="margin:0; font-size:20px; font-weight:700; color:#1a1f36; line-height:1.35; letter-spacing:-0.01em;">Tu pedido #{{orderNumber}} está listo para retirar</h2>
<p style="margin:12px 0 0; color:#4f566b; font-size:13.5px; line-height:1.7;">¡Buenas noticias! Tu pedido en <strong style="color:#1a1f36;">{{storeName}}</strong> ya está preparado y te espera.</p>
{{#if pickupAddress}}
<div style="margin-top:20px; background:#f6f8fa; border:1px solid #e3e8ee; border-radius:8px; padding:16px 18px;"><div style="font-size:11px; color:#8792a2; text-transform:uppercase; letter-spacing:0.05em; margin-bottom:6px;">Retiralo en</div><div style="font-size:19px; font-weight:700; color:#1a1f36; font-family:'Geist Mono',Consolas,monospace; letter-spacing:0.03em;"><span style="font-family:inherit; letter-spacing:0; font-size:15px;">{{pickupAddress}}</span></div></div>
{{/if}}
<p style="margin:20px 0 0; color:#8792a2; font-size:11.5px; line-height:1.65;">Acordate de mencionar el número de pedido cuando vengas a buscarlo.</p>

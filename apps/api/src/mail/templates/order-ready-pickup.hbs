{{!-- Estilo "Transaccional sobrio" (elección del equipo 19/08): alineado a la izquierda, sin decoración — ver email-layout.hbs --}}
<h2 style="margin:0; font-size:18px; font-weight:700; color:#1a1f36; line-height:1.35;">Tu pedido #{{orderNumber}} está listo para retirar</h2>
<p style="margin:10px 0 0; color:#4f566b; font-size:13px; line-height:1.65;">¡Buenas noticias! Tu pedido en <strong style="color:#1a1f36;">{{storeName}}</strong> ya está preparado y te espera.</p>
{{#if pickupAddress}}
<div style="margin-top:18px; background:#f6f8fa; border:1px solid #e3e8ee; border-radius:6px; padding:14px 16px;"><div style="font-size:11px; color:#8792a2; text-transform:uppercase; letter-spacing:0.04em; margin-bottom:6px;">Retiralo en</div><div style="font-size:18px; font-weight:700; color:#1a1f36; font-family:'Geist Mono',Consolas,monospace; letter-spacing:0.03em;"><span style="font-family:inherit; letter-spacing:0;">{{pickupAddress}}</span></div></div>
{{/if}}
<p style="margin:18px 0 0; color:#8792a2; font-size:11px; line-height:1.6;">Acordate de mencionar el número de pedido cuando vengas a buscarlo.</p>

{{!-- Estilo "Transaccional sobrio" v2 (equipo 19/08) — ver email-layout.hbs --}}
<h2 style="margin:0; font-size:20px; font-weight:700; color:#1a1f36; line-height:1.35; letter-spacing:-0.01em;">Recibimos tu pedido #{{orderNumber}}</h2>
<p style="margin:12px 0 0; color:#4f566b; font-size:13.5px; line-height:1.7;"><strong style="color:#1a1f36;">{{storeName}}</strong> cargó tu pedido y ya está en su lista. Este es el detalle:</p>
{{> order-items-table this}}
{{#if orderUrl}}
{{> cta-button this url=orderUrl label="Ver mi pedido"}}
{{/if}}
<p style="margin:20px 0 0; color:#8792a2; font-size:11.5px; line-height:1.65;">Te vamos a avisar por este medio cuando el pedido esté confirmado y cada vez que avance.</p>

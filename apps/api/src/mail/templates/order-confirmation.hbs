{{!-- Estilo "Transaccional sobrio" v2 (equipo 19/08) — ver email-layout.hbs --}}
<h2 style="margin:0; font-size:20px; font-weight:700; color:#1a1f36; line-height:1.35; letter-spacing:-0.01em;">Pedido #{{orderNumber}} confirmado</h2>
<p style="margin:12px 0 0; color:#4f566b; font-size:13.5px; line-height:1.7;">¡Gracias por tu compra en <strong style="color:#1a1f36;">{{storeName}}</strong>! Ya estamos trabajando en tu pedido. Este es el detalle:</p>
{{> order-items-table this}}
{{#if orderUrl}}
{{> cta-button this url=orderUrl label="Ver mi pedido"}}
{{/if}}
<p style="margin:20px 0 0; color:#8792a2; font-size:11.5px; line-height:1.65;">Te vamos a ir avisando por este medio cada vez que tu pedido avance.</p>

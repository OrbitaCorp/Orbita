{{!-- Estilo "Transaccional sobrio" (elección del equipo 19/08): alineado a la izquierda, sin decoración — ver email-layout.hbs --}}
<h2 style="margin:0; font-size:18px; font-weight:700; color:#1a1f36; line-height:1.35;">Pedido #{{orderNumber}} confirmado</h2>
<p style="margin:10px 0 0; color:#4f566b; font-size:13px; line-height:1.65;">Gracias por tu compra en <strong style="color:#1a1f36;">{{storeName}}</strong>. Este es el detalle:</p>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-top:18px;">
  <tr>
    <td style="font-size:11px; color:#8792a2; text-transform:uppercase; letter-spacing:0.04em; padding-bottom:6px;">Producto</td>
    <td style="font-size:11px; color:#8792a2; text-transform:uppercase; letter-spacing:0.04em; padding-bottom:6px; text-align:right;">Importe</td>
  </tr>
  {{#each items}}
  <tr>
    <td style="padding:8px 0; border-top:1px solid #e3e8ee; font-size:13px; color:#1a1f36;">{{this.name}} <span style="color:#8792a2;">× {{this.quantity}}</span></td>
    <td style="padding:8px 0; border-top:1px solid #e3e8ee; font-size:13px; color:#1a1f36; text-align:right; white-space:nowrap;">{{this.price}}</td>
  </tr>
  {{/each}}
  <tr>
    <td style="padding:10px 0 0; font-size:13.5px; font-weight:700; color:#1a1f36;">Total</td>
    <td style="padding:10px 0 0; font-size:13.5px; font-weight:700; color:#1a1f36; text-align:right;">{{total}} <span style="font-weight:400; color:#8792a2;">ARS</span></td>
  </tr>
</table>

<div style="text-align:center;">
  <h2 style="margin:0; font-size:22px; font-weight:800; color:#0f172a; line-height:1.25;">Pedido #{{orderNumber}} confirmado</h2>
  <p style="margin:14px auto 0; color:#475569; font-size:13px; line-height:1.6; max-width:320px;">Gracias por tu compra en <strong style="color:#0f172a;">{{storeName}}</strong>. Así quedó tu pedido:</p>
</div>
<div style="margin-top:20px; background:{{colorPrimaryTint}}; border-radius:14px; padding:18px 20px;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
    {{#each items}}
    <tr>
      <td style="padding:8px 0; border-bottom:1px dashed rgba(15,23,42,0.12); font-size:13.5px; color:#0f172a;">{{this.name}} <span style="color:#64748b;">× {{this.quantity}}</span></td>
      <td style="padding:8px 0; border-bottom:1px dashed rgba(15,23,42,0.12); font-size:13.5px; color:#0f172a; text-align:right; white-space:nowrap;">{{this.price}}</td>
    </tr>
    {{/each}}
    <tr>
      <td style="padding:12px 0 0; font-size:15px; font-weight:800; color:#0f172a;">Total</td>
      <td style="padding:12px 0 0; font-size:16px; font-weight:800; color:{{colorPrimary}}; text-align:right;">{{total}}</td>
    </tr>
  </table>
</div>

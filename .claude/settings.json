{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "command -v graphify >/dev/null 2>&1 || exit 0; graphify hook-guard search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "command -v graphify >/dev/null 2>&1 || exit 0; graphify hook-guard read"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "orbita-videos": {
      "source": {
        "source": "github",
        "repo": "Gisterkuk/Orbita-Videos"
      }
    }
  },
  "enabledPlugins": {
    "orbita-videos@orbita-videos": true
  }
}
